    {
        "id": "11258eec805a5362",
        "type": "function",
        "z": "8ca92ed7e7db51ee",
        "name": "function 1",
        "func": "// 1. Maak van de tekst weer een object\nlet data = JSON.parse(msg.payload);\n\n// 2. Logica: We checken of de CO2 niet bizar hoog is (foutmeting)\nif (data.co2 > 5000) {\n    node.warn(\"Onrealistische CO2 waarde genegeerd!\");\n    return null;\n}\n\n// 3. Klaarmaken voor InfluxDB\nmsg.payload = {\n    temperatuur: data.temperatuur,\n    luchtvochtigheid: data.luchtvochtigheid,\n    co2: data.co2\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
