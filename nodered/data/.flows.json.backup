    {
        "id": "11258eec805a5362",
        "type": "function",
        "z": "8ca92ed7e7db51ee",
        "name": "Function",
        "func": "// Payload object validation\nif (typeof msg.payload !== 'object') {\n    node.error(\"Payload is niet formaat: JSON Object\");\n    return null;\n}\n\n// Metadata extraction\nlet topicParts = msg.topic.split('/');\nlet sensorID = topicParts[topicParts.length - 1];\n\nlet d = msg.payload;\n\n// Data validation\nlet isValid = (\n    d.temperatuur >= -10 && d.temperatuur <= 32 &&\n    d.luchtvochtigheid >= 50 && d.luchtvochtigheid <= 90 &&\n    d.co2 >= 400 && d.co2 <= 500\n);\n\nif (!isValid) {\n    node.warn(`Invalid data in ${sensorID} gedropt...`);\n    return null;\n}\n\n// InfluxDB formatting\nmsg.payload = {\n    temperatuur: d.temperatuur,\n    luchtvochtigheid: d.luchtvochtigheid,\n    co2: d.co2\n};\n\nmsg.tags = {\n    device: sensorID\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 180,
